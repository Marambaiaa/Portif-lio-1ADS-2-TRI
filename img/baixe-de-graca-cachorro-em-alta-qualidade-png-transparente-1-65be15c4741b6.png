                }
                if (e.type === 'scroll') {
                    hadScroll = true;
                }
                tryLoad();
            }

            ['mousemove','click','touchstart','scroll','keydown'].forEach(function(e) {
                document.addEventListener(e, onInteraction, {capture: true, passive: true});
            });

            // Fallback: load after 8s but ONLY if had at least one interaction signal
            setTimeout(function() {
                if (hadMouseOrTouch || hadScroll) tryLoad();
            }, 8000);
        })();
    </script>

    <!-- Service Worker -->
    <script>
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/sw.js').catch(function() {})
        }
    </script>
